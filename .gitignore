# --- Editor / harness ---
.idea/
.opencode/
opencode.exe

# --- Tooling package build artifacts ---
.dart_tool/

# --- Generated (regenerated by `flutter pub get`) ---
app/lib/l10n/app_localizations*.dart

# --- Generated build output ---
dist/
