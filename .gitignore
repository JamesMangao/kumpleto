app/assets/data/data.json
app/assets/data/data_drafts.json

# --- Secrets: MUST NEVER be committed ---
key.properties
*.jks
*.keystore
google-services.json
service-account*.json

# --- OS junk ---
Thumbs.db
.DS_Store
.oxcode-memory/
.tmp-jdk/
.cloud-attachments/
