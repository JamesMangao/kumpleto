{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jamesmangao.github.io/kumpleto/schema/document.schema.json",
  "title": "Kumpleto document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "agency", "status"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Kebab-case; must equal the filename without extension."
    },
    "name": { "$ref": "#/definitions/bilingual" },
    "agency": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Key into agencies.yaml."
    },
    "status": { "enum": ["draft", "verified", "deprecated"] },
    "summary": { "$ref": "#/definitions/bilingualOrNull" },
    "source_url": { "$ref": "#/definitions/httpsUrlOrNull" },
    "last_verified": {
      "oneOf": [
        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        { "type": "null" }
      ]
    },
    "verified_by": {
      "oneOf": [{ "type": "string" }, { "type": "null" }],
      "description": "GitHub handle of the verifier (maintainer-only field)."
    },
    "validity_months": {
      "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
    },
    "apply_online": { "oneOf": [{ "type": "boolean" }, { "type": "null" }] },
    "apply_online_url": { "$ref": "#/definitions/httpsUrlOrNull" },
    "where_to_apply": { "$ref": "#/definitions/bilingualOrNull" },
    "depends_on": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "uniqueItems": true
    },
    "requirements": {
      "type": "array",
      "items": { "$ref": "#/definitions/requirement" }
    },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/definitions/bilingual" }
    },
    "fee_note": { "$ref": "#/definitions/bilingualOrNull" },
    "processing_note": { "$ref": "#/definitions/bilingualOrNull" },
    "notes": {
      "type": "array",
      "items": { "$ref": "#/definitions/bilingual" }
    }
  },
  "definitions": {
    "bilingual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "fil"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "fil": { "type": "string", "minLength": 1 }
      }
    },
    "bilingualOrNull": {
      "oneOf": [
        { "$ref": "#/definitions/bilingual" },
        { "type": "null" }
      ]
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://",
      "description": "HTTPS only. Should be an official source (.gov.ph preferred; warn-only)."
    },
    "httpsUrlOrNull": {
      "oneOf": [
        { "$ref": "#/definitions/httpsUrl" },
        { "type": "null" }
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Unique within the document."
        },
        "text": { "$ref": "#/definitions/bilingual" },
        "original": { "type": "boolean", "default": false },
        "photocopies": { "type": "integer", "minimum": 0, "default": 0 },
        "optional": { "type": "boolean", "default": false },
        "note": { "$ref": "#/definitions/bilingualOrNull" }
      }
    }
  }
}
