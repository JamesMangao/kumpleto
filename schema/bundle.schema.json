{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jamesmangao.github.io/kumpleto/schema/bundle.schema.json",
  "title": "Kumpleto bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "description", "status", "documents"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Kebab-case; must equal the filename without extension."
    },
    "name": { "$ref": "#/definitions/bilingual" },
    "description": { "$ref": "#/definitions/bilingual" },
    "status": { "enum": ["draft", "verified", "deprecated"] },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "uniqueItems": true,
      "description": "Ordered document ids; every id must exist in data/documents/."
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "uniqueItems": true
    },
    "icon": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Material icon name (e.g. work, flight_takeoff, directions_car, autorenew)."
    },
    "notes": {
      "type": "array",
      "items": { "$ref": "#/definitions/bilingual" },
      "description": "Optional community notes (e.g. unverified-law pointers kept as draft)."
    }
  },
  "definitions": {
    "bilingual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "fil"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "fil": { "type": "string", "minLength": 1 }
      }
    }
  }
}
